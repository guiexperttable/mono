{
  "name": "angular-build-ng17",
  "version": "17.1.101",
  "private": true,
  "description": "Build harness: compiles packages/angular-table/src for Angular 17 -> @guiexpert/angular-table@17.x",
  "license": "MIT",
  "scripts": {
    "sync": "node ../../scripts/sync-angular-src.mjs ng17",
    "build": "node ../../scripts/sync-angular-src.mjs ng17 && ng-packagr -p lib/ng-package.json -c lib/tsconfig.lib.prod.json",
    "npm-pub": "npm publish ./dist --access public --tag a17"
  },
  "dependencies": {
    "@guiexpert/table": "workspace:^"
  },
  "devDependencies": {
    "@angular/common": "^17.1.1",
    "@angular/core": "^17.1.1",
    "@angular/compiler": "^17.1.1",
    "@angular/platform-browser": "^17.1.1",
    "@angular/compiler-cli": "^17.1.1",
    "ng-packagr": "^17.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.2.2"
  }
}
