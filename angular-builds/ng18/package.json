{
  "name": "angular-build-ng18",
  "version": "18.1.84",
  "private": true,
  "description": "Build harness: compiles packages/angular-table/src for Angular 18 -> @guiexpert/angular-table@18.x",
  "license": "MIT",
  "scripts": {
    "sync": "node ../../scripts/sync-angular-src.mjs ng18",
    "build": "node ../../scripts/sync-angular-src.mjs ng18 && ng-packagr -p lib/ng-package.json -c lib/tsconfig.lib.prod.json",
    "npm-pub": "npm publish ./dist --access public --tag a18"
  },
  "dependencies": {
    "@guiexpert/table": "workspace:^"
  },
  "devDependencies": {
    "@angular/common": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "ng-packagr": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.4.5"
  }
}
