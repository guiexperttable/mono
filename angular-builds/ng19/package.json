{
  "name": "angular-build-ng19",
  "version": "19.1.89",
  "private": true,
  "description": "Build harness: compiles packages/angular-table/src for Angular 19 -> @guiexpert/angular-table@19.x",
  "license": "MIT",
  "scripts": {
    "sync": "node ../../scripts/sync-angular-src.mjs ng19",
    "build": "node ../../scripts/sync-angular-src.mjs ng19 && ng-packagr -p lib/ng-package.json -c lib/tsconfig.lib.prod.json",
    "npm-pub": "npm publish ./dist --access public --tag a19"
  },
  "dependencies": {
    "@guiexpert/table": "workspace:^"
  },
  "devDependencies": {
    "@angular/common": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "ng-packagr": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.6.3"
  }
}
