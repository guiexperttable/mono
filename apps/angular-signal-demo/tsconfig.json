{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "dom"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
