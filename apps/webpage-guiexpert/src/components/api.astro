---
/**
 * /api/ – entry page of the API reference. The reference itself is generated by typedoc
 * (packages/table: pnpm typedoc:website → public/api). All links are checked against the typedoc index.
 */
import ApiLink from "./training/ApiLink.astro";
import { chapterUrl, chapterBySlug } from "../training/chapters";
import "../styles/training.css";

interface Group {
  title: string;
  lead: string;
  items: { name: string; text: string }[];
  training: string[];
}

const GROUPS: Group[] = [
  {
    title: "Table & API",
    lead: "Create a table and control it.",
    items: [
      { name: "TableScope", text: "creates and runs a table in a host element" },
      { name: "TableApi", text: "scroll, sort, filter, copy, export, update cells" },
      { name: "TableScope.destroy", text: "release a table (listeners, observers, renderers)" }
    ],
    training: ["first-table", "web-component-and-cdn"]
  },
  {
    title: "Table model",
    lead: "From your data to a model.",
    items: [
      { name: "TableFactory", text: "createTableModel, buildByTypedRows, createByAreaModels" },
      { name: "CreateTableModelPara", text: "all parameters of createTableModel" },
      { name: "TableModelIf", text: "header, body, footer + columns + fixed columns" }
    ],
    training: ["array-to-table-model", "array-of-arrays", "fixed-columns"]
  },
  {
    title: "Area models",
    lead: "Header, body and footer – or a model of your own.",
    items: [
      { name: "AreaModelIf", text: "what the table asks: row count, values, heights, spans, styles" },
      { name: "AreaModel", text: "base class for own models (millions of rows, totals, server data)" },
      { name: "AreaModelObjectArray", text: "objects – filtered and sorted rows" },
      { name: "AreaModelArrayOfArrays", text: "rows of values" }
    ],
    training: ["table-model-areas", "custom-area-model", "footer-totals"]
  },
  {
    title: "Columns",
    lead: "Label, width, alignment, renderers, sorting, editing.",
    items: [
      { name: "ColumnDef", text: "new ColumnDef(…) and ColumnDef.create({ … })" },
      { name: "ColumnDefIf", text: "every field of a column" },
      { name: "Size", text: "px, % and weight widths – constants px0 … px500" }
    ],
    training: ["column-definitions", "sorting"]
  },
  {
    title: "Options",
    lead: "Behaviour and look of a table.",
    items: [
      { name: "TableOptions", text: "all defaults – use { ...new TableOptions(), … }" },
      { name: "TableOptionsIf", text: "every option explained" },
      { name: "AutoRestoreOptions", text: "remember sorting, scroll position, open nodes" }
    ],
    training: ["table-options", "persist-state"]
  },
  {
    title: "Events, selection & keyboard",
    lead: "React to what the user does.",
    items: [
      { name: "EventAdapter", text: "override only the events you need" },
      { name: "GeMouseEvent", text: "area, row, column, click count, browser event" },
      { name: "SelectionModel", text: "cells, rows, columns or ranges" },
      { name: "ShortcutService", text: "keyboard shortcuts and actions" }
    ],
    training: ["events-and-context-menu", "selection-and-copy"]
  },
  {
    title: "Renderers & styling",
    lead: "How cells look.",
    items: [
      { name: "CellRendererIf", text: "an own renderer in one method" },
      { name: "NumberCellProgressBarCellRenderer", text: "one of the built-in renderers" },
      { name: "GeCssColorUtil", text: "colour gradients for heatmaps" },
      { name: "CssVars", text: "the --ge-table-* CSS variables" }
    ],
    training: ["cell-renderers", "heatmap", "theming-dark-mode"]
  },
  {
    title: "Trees, groups, export",
    lead: "The rest of the toolbox.",
    items: [
      { name: "TreeFactory", text: "hierarchical data → tree rows" },
      { name: "AreaModelCellGroups", text: "grouped, collapsible headers" },
      { name: "ExcelService", text: ".xlsx without a library" },
      { name: "TableCellUpdateEvent", text: "live updates of single cells" }
    ],
    training: ["tree-table", "header-groups", "excel-export", "live-data"]
  }
];
---

<section class="training-hero" style="padding-bottom: 0">
  <p class="chapter-no">@guiexpert/table · TypeScript API</p>
  <h1><span class="gradient-text">API</span> reference</h1>
  <p class="lead">
    Every class, interface and option of the core – with examples that are compiled against the real code.
    The framework packages are thin wrappers around exactly this API.
  </p>
  <div class="training-cta">
    <a class="btn-gradient" href="/api/overview.html">Open the full reference →</a>
    <a class="btn-outline" href="/training/">Learn it step by step</a>
    <a class="btn-outline" href="/api/modules.html">All symbols A–Z</a>
  </div>
</section>

<section class="training-section" style="padding-bottom: 5rem">
  <h2>Where to start</h2>
  <p class="sub">The most important types, grouped like the reference. Each group links to the chapters of the training that use them.</p>
  <div class="chapter-cards">
    {GROUPS.map(group => (
      <div class="chapter-card api-group">
        <b>{group.title}</b>
        <p>{group.lead}</p>
        <ul>
          {group.items.map(item => (
            <li><ApiLink name={item.name} /> <span>– {item.text}</span></li>
          ))}
        </ul>
        <span class="card-meta">
          Training: {group.training.map((slug, i) => (
            <>{i > 0 && " · "}<a href={chapterUrl(slug)}>{chapterBySlug(slug).nav}</a></>
          ))}
        </span>
      </div>
    ))}
  </div>
</section>

<style is:global>
  .api-group ul { display: grid; gap: 0.4rem; margin: 0.4rem 0 0.6rem; font-size: 0.88rem; }
  .api-group li span { color: var(--color-text-offset); }
  .api-group .card-meta a { color: var(--color-secondary); }
  .api-group .card-meta a:hover { text-decoration: underline; }
  .api-group:hover { transform: none; }
</style>
