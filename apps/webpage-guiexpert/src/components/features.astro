---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";
import "../styles/home.css";

interface Feature {
  title: string;
  description: string;
  icon: string;
  url: string;
  more: string;
}

const features: Feature[] = [
  {
    title: "Fast at any size",
    description: "Virtual scrolling in both directions: only visible rows and columns are in the DOM. " +
      "The rendering cost depends on the viewport, not on your data.",
    icon: "mdi:speedometer",
    url: "/showcase/large/run/",
    more: "See 2 million rows"
  },
  {
    title: "One core, every framework",
    description: "Angular 14 – 22, React, Vue 3, Svelte 4 / 5, Solid, Preact, Web Component and plain JavaScript – " +
      "the same model, options and API everywhere.",
    icon: "mdi:layers-triple",
    url: "/getstarted/",
    more: "Get started"
  },
  {
    title: "Flexible models",
    description: "Flat and tree tables, grouped headers, total rows that follow filter and sorting (sum, average, count …), " +
      "rowspan and colspan, fixed columns on both sides, row numbers like in a spreadsheet – or a model of your own " +
      "that computes values on demand.",
    icon: "mdi:file-tree",
    url: "/training/table-model-areas/",
    more: "The table model"
  },
  {
    title: "Data tools built in",
    description: "Sorting with own comparators, filtering with your own UI, cell, row, column and range selection, " +
      "row grouping with totals per group, pivot tables with subtotals and totals, calculated columns and formulas " +
      "(\"[price] * [quantity]\", shares of the total, running totals, ranks), master/detail with nested tables, the sum of the selected cells for a status bar, clipboard and Excel " +
      "export, loading and \"no rows\" overlays – " +
      "without an extra library.",
    icon: "mdi:filter-variant",
    url: "/training/sorting/",
    more: "Sorting, filtering, export"
  },
  {
    title: "Accessible and editable",
    description: "A WAI-ARIA grid for screen readers and full keyboard navigation, inline editing with text and select " +
      "editors, a fill handle and batch edit (collect changes, then save), resizable and movable columns, rows dragged into order (mouse, touch or Ctrl+Alt+↑/↓), live updates – " +
      "and a table that remembers its layout, sorting and selection, in localStorage or on your server.",
    icon: "mdi:account-voice",
    url: "/training/accessibility/",
    more: "Accessibility and editing"
  },
  {
    title: "Your look",
    description: "Cell renderers and framework components in cells, heatmaps, CSS variables, light and dark themes – " +
      "full control over HTML and CSS.",
    icon: "mdi:palette",
    url: "/training/cell-renderers/",
    more: "Renderers and theming"
  }
];
---

<ContentSection title="Everything included" id="features">
  <Fragment slot="lead">
    Every feature is part of the <span class="text-primary">MIT-licensed</span> core – in every framework.
  </Fragment>
  <div class="home-features">
    {
      features.map(f => (
        <a class="home-feature" href={f.url}>
          <span class="home-feature-icon"><Icon name={f.icon} /></span>
          <h3>{f.title}</h3>
          <p>{f.description}</p>
          <span class="more">{f.more} →</span>
        </a>
      ))
    }
  </div>
</ContentSection>
