---
import { Icon } from "astro-icon/components";
import HeroImage from "~/components/hero-image.astro";
import type { FooterLink } from "~/types";

const links: Array<FooterLink> = [
  {
    url: "https://gui.expert/",
    description: "GUI Expert's official website",
    icon: "mdi:home",
  },
  {
    url: "https://github.com/guiexperttable/mono",
    description: "View source on GitHub",
    icon: "fa-brands:github-alt",
  },
  {
    url: "https://twitter.com/marckronberg",
    description: "Marc Kronberg on Twitter",
    icon: "fa-brands:twitter",
  },
];
---

<footer class="relative flex h-64 flex-col items-center justify-center gap-6">
  <div class="absolute inset-0 overflow-hidden opacity-40">
    <HeroImage />
  </div>
  <ul class="relative grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      links.map((link) => (
        <li>
          <a
            class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-current p-4"
            href={link.url}
          >
            <span class="sr-only">{link.description}</span>
            <Icon class="h-full" name={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
  <nav class="relative flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm" aria-label="Legal and more">
    <a href="/imprint/">Imprint</a>
    <a href="/license/">License</a>
    <a href="/doc/">Documentation</a>
    <a href="/posts/">Articles</a>
    <span class="text-offset">© {new Date().getFullYear()} Dr. Marc Kronberg</span>
  </nav>
</footer>
