---
import CompatibilityList from "./getstarted-list.astro";
import ContentSection from "~/components/content-section.astro";
import type { CompatibilityItem } from "~/types";
import { CHAPTERS } from "~/training/chapters";

const frameworks: Array<CompatibilityItem> = [
  {
    title: "Plain JS",
    icon: "frameworks/js",
    url: "plainjs/",
  },
  {
    title: "Angular",
    icon: "frameworks/angular",
    url: "angular/",
  },
  {
    title: "Vue",
    icon: "frameworks/vue",
    url: "vue/",
  },
  {
    title: "React",
    icon: "frameworks/react",
    url: "react/",
  },
  {
    title: "Preact",
    icon: "frameworks/preact",
    url: "preact/",
  },
  {
    title: "Svelte",
    icon: "frameworks/svelte",
    url: "svelte/",
  },
  {
    title: "Solid",
    icon: "frameworks/solid",
    url: "/training/one-model-every-framework/",
  },
  {
    title: "WebComponent",
    icon: "frameworks/lit",
    url: "webcomponent/",
  },
];

---

<ContentSection title="Get started" id="getstarted">
  <Fragment slot="lead">
    One package, a model and a container with a height – in
    <span class="text-primary">plain JavaScript</span> or the framework you already use:
  </Fragment>
  <CompatibilityList
    items={frameworks}
    title="Frameworks"
    url="/getstarted"
  />
  <p class="max-w-xl text-center">
    New to the table? The <a class="text-primary" href="/training/">training</a> walks you through it in {CHAPTERS.length} short
    chapters with live demos – from the first table to two million rows, pivot tables and master/detail. The
    <a class="text-primary" href="/doc/">documentation</a> explains the concepts behind it.
  </p>
  <p class="text-right text-sm">
    <a class="text-primary" href="/training/">Training: step by step &rarr;</a> &nbsp;
    <a class="text-primary" href="/json2ts"> JSON to TypeScript Generator &rarr;</a>
  </p>
</ContentSection>
