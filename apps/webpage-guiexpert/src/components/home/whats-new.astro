---
/**
 * Home page: recent releases. The features come from src/features/new-features.ts (same list as /whats-new/).
 */
import ContentSection from "~/components/content-section.astro";
import { CHAPTERS } from "../../training/chapters";
import { NEW_FEATURES, FeatureCountWord, featureCountWord, liveTitle, showcaseHref, type NewFeature } from "../../features/new-features";
import "../../styles/home.css";

const GROUPS: { tag: string; title: string; from: string; to: string }[] = [
  { tag: "v1.1.97 – 1.1.100", title: "Master/detail, right-to-left, a spreadsheet, Angular Signals", from: "1.1.97", to: "1.1.100" },
  { tag: "v1.1.94 – 1.1.96", title: "Spreadsheet power", from: "1.1.94", to: "1.1.96" },
  { tag: "v1.1.91 – 1.1.93", title: "Accessible, friendly, remembers you", from: "1.1.91", to: "1.1.93" }
];
const num = (v: string) => Number(v.split(".")[2]);
const inGroup = (f: NewFeature, g: (typeof GROUPS)[number]) => num(f.since) >= num(g.from) && num(f.since) <= num(g.to);
const enterprise = NEW_FEATURES.filter(f => f.agGrid === "enterprise").length;
---

<ContentSection title="What's new" id="news">
  <Fragment slot="lead">
    <span class="text-primary">{FeatureCountWord()} features</span> in October 2026 – {enterprise} of them are Enterprise features at ag-Grid.
  </Fragment>
  <div class="home-news">
    {GROUPS.map(g => (
      <article>
        <span class="tag">{g.tag} · October 2026</span>
        <h3>{g.title}</h3>
        <ul>
          {NEW_FEATURES.filter(f => inGroup(f, g)).map(f => (
            <li>
              <a href={`/whats-new/#${f.id}`}>{f.title}</a>
              {" "}(<a href={showcaseHref(f)} aria-label={f.showcase ? `Live showcase: ${liveTitle(f)}` : liveTitle(f)}>{f.showcase ? "live" : "demo"}</a>)
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
  <p class="home-links">
    <a href="/whats-new/">All {featureCountWord()} with code →</a>
    <a href="/training/">Training: {CHAPTERS.length} chapters with live demos →</a>
    <a href="https://github.com/guiexperttable/mono/releases">All releases on GitHub →</a>
  </p>
</ContentSection>
