---

const id = 'div' + Math.random().toString(36).slice(2, 11);
---

<div class="covergrid-bar">
  <label>Search <input type="search" class={id + '-search'} placeholder="title, author, genre" autocomplete="off"></label>
  <label>Size <select class={id + '-size'}>
    <option value="100x170">small</option>
    <option value="160x260" selected>medium</option>
    <option value="220x340">large</option>
  </select></label>
  <label>Order <select class={id + '-order'}>
    <option value="id" selected>collection</option>
    <option value="title">title</option>
    <option value="author">author</option>
    <option value="year">newest first</option>
  </select></label>
  <span class:list={[id + '-log', 'covergrid-log']} aria-live="polite"></span>
</div>
<div
    style="height: calc(100vh - 176px)"
    class:list={[ id, 'covergrid-demo' ]}></div>

<script
    is:inline
    define:vars={{id}}
    type="module">

  import { TableScope, EventAdapter, SimpleDomService } from '/scripts/table/index.js'
  import {
    createCoverGridModelAndOptions, generateBooks, fitCoversToWidth, BOOK_SORTS
  } from "/scripts/demo-table-models/index.js";

  const $ = suffix => document.querySelector('.' + id + suffix);
  const ele = $('');
  const log = $('-log');
  const sizeSelect = $('-size');

  // 10,000 books – a cover grid renders only the visible rows, like every GuiExpert Table
  const books = generateBooks(10_000);
  let searchText = '';
  let selected;
  const size = () => sizeSelect.value.split('x').map(Number);

  const [coverWidth, coverHeight] = size();
  const {tableModel, tableOptions} = createCoverGridModelAndOptions(books, coverWidth, coverHeight, {
    filter: book => !searchText || `${book.title} ${book.author} ${book.genre}`.toLowerCase().includes(searchText),
    isSelected: book => book === selected
  });

  const report = () => {
    const shown = tableModel.bodyModel.filteredItems.length;
    const pick = selected ? ` · ${selected.title} – ${selected.author} (${selected.year})` : '';
    log.textContent = `${shown.toLocaleString()} books${pick}`;
  };

  const listener = new EventAdapter();
  listener.onMouseClicked = evt => {
    if (evt.areaIdent !== 'body') return;
    // the item under the mouse: row × columns + column
    const book = tableModel.bodyModel.getValueAt(evt.rowIndex, evt.columnIndex);
    if (!book) return;
    selected = book;
    tableApi.repaint();
    report();
  };

  const tableScope = new TableScope(ele, tableModel, new SimpleDomService(), tableOptions, listener);
  tableScope.firstInit();
  const tableApi = tableScope.getApi();

  // size: tiles fill the width – columns = floor(width / tile width), no new model, just repaint
  const applySize = () => {
    const [w, h] = size();
    fitCoversToWidth(tableModel, w, h);
    tableApi.repaintHard();
  };
  applySize();
  report();
  sizeSelect.addEventListener('change', applySize);
  new ResizeObserver(() => requestAnimationFrame(() => {
    tableApi.recalcColumnWidths();   // the new width at once (the table's own observer is debounced)
    applySize();
  })).observe(ele);

  let timer;
  $('-search').addEventListener('input', e => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      searchText = e.target.value.trim().toLowerCase();
      tableApi.externalFilterChanged();   // filters, keeps the order, scrolls to the top
      report();
    }, 150);
  });
  $('-order').addEventListener('change', e => tableApi.sort(BOOK_SORTS[e.target.value]));
</script>

<style is:global>
    .covergrid-demo {
        font-size: 14px;
    }
    /* tiles, not cells: no focus frame around the clicked cell – the renderer frames the selected book */
    .covergrid-demo .ge-table-focus-border {
        display: none;
    }
    .covergrid-bar {
        display: flex;
        gap: 16px;
        align-items: center;
        padding: 8px 12px;
        flex-wrap: wrap;
        font-size: 14px;
    }
    .covergrid-bar input,
    .covergrid-bar select {
        font: inherit;
        padding: 3px 8px;
        border: 1px solid currentColor;
        border-radius: 4px;
        background: transparent;
        color: inherit;
    }
    .covergrid-bar option {
        color: #000;
    }
    .covergrid-log {
        opacity: 0.8;
    }
</style>
