---
/**
 * Link to the API reference (/api/…, generated by typedoc).
 *   <ApiLink name="TableApi" />                    → class page
 *   <ApiLink name="TableApi.sortByColumn" />        → member anchor
 *   <ApiLink name="TableApi.sort" label="sort(fn)" />
 * Unknown names fail the build (index: src/training/api-index.json, see scripts/build-api-index.mjs).
 */
import { apiEntry } from "../../training/api";

interface Props {
  name: string;
  label?: string;
  /** render the label as code (default) */
  code?: boolean;
}

const { name, label, code = true } = Astro.props;
const entry = apiEntry(name);
const text = label ?? (entry.kind === "method" ? `${name}()` : name);
---
<a class="api-link" href={entry.url} title={`API reference: ${name} (${entry.kind})`}>{code ? <code>{text}</code> : text}</a>
