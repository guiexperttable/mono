---
/** Diagram: one core, many thin wrappers (part 3). */
const wrappers = [
  "Angular 14–22", "React", "Vue 3", "Svelte 4/5", "Solid", "Preact", "Web Component", "Plain TS"
];
---
<figure class="training-diagram">
  <svg viewBox="0 0 860 230" role="img" aria-labelledby="wr-title">
    <title id="wr-title">Eight thin wrappers on top of one framework-free core with zero runtime dependencies</title>
    <defs>
      <linearGradient id="wr-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6366f1" /><stop offset="0.5" stop-color="#d946ef" /><stop offset="1" stop-color="#ec4899" />
      </linearGradient>
    </defs>
    <g font-family="Inter Variable, system-ui, sans-serif" font-size="13">
      <text x="20" y="22" font-weight="700" fill="var(--color-text)">Your app</text>
      {wrappers.map((w, i) => (
        <g>
          <rect x={20 + i * 103} y="34" width="96" height="52" rx="8" fill="var(--color-background-offset)" stroke="var(--color-border)" />
          <text x={68 + i * 103} y="64" text-anchor="middle" font-size="12" font-weight="600" fill="var(--color-text)">{w}</text>
          <path d={`M${68 + i * 103} 88 L ${68 + i * 103} 124`} stroke="var(--color-text-offset)" stroke-dasharray="3 3" />
        </g>
      ))}
      <text x="20" y="112" font-size="11" fill="var(--color-text-offset)">thin wrapper: creates the TableScope, maps events to props / outputs / CustomEvents</text>
      <rect x="20" y="126" width="820" height="72" rx="12" fill="url(#wr-grad)" />
      <text x="430" y="156" text-anchor="middle" font-size="17" font-weight="800" fill="#fff">@guiexpert/table – the core</text>
      <text x="430" y="180" text-anchor="middle" font-size="12" fill="#fff">TableModel · TableOptions · TableScope · TableApi · renderers · CSS variables · 0 runtime dependencies</text>
      <text x="20" y="220" font-size="11" fill="var(--color-text-offset)">→ the same model and options work in every framework</text>
    </g>
  </svg>
</figure>
