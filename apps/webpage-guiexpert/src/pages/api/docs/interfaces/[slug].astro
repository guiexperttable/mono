---
import Header from "../../../../components/header.astro";
import IndexLayout from "../../../../layouts/IndexLayout.astro";
import {marked} from "marked";


export async function getStaticPaths() {
  // Astro.glob() was removed in Astro 6 – import.meta.glob returns the same markdown modules
  const posts: any[] = Object.values(import.meta.glob('../../../../content/docsmd/interfaces/*.md', { eager: true }));
  return posts.map((post) => {
    return {
      // params: {slug: post.frontmatter.slug},
      params:{
        slug: post.file.split('/').findLast(f=>f.includes('.md'))
      },
      props: {...post}
    }
  })
}

const {Content, frontmatter} = Astro.props;
const debug = JSON.stringify( Astro.props);
// The markdown (typedoc-plugin-markdown) links to other .md files – point them to the HTML reference in /api/ instead.
const KINDS = "classes|interfaces|types|functions|variables|enums";
const content = (marked.parse(Astro.props.rawContent()) as string)
  .replace(new RegExp(`href="(?:\\.\\./)?(${KINDS})/([^"#]+)\\.md(#[^"]*)?"`, "g"), 'href="/api/$1/$2.html"')
  .replace(/href="\.\.\/README\.md(#[^"]*)?"/g, 'href="/api/overview.html"')
  .replace(/href="\.\.\/modules\.md(#[^"]*)?"/g, 'href="/api/modules.html"')
  .replace(/href="([A-Za-z0-9_]+)\.md(#[^"]*)?"/g, 'href="/api/interfaces/$1.html"');
---
<IndexLayout title="Docs">
  <Header/>

  <!--<Content/>-->
  <div set:html={content} />

</IndexLayout>
