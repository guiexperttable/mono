{
  "//": "Type check of the training demos (src/training) against the built core (pnpm build:core): pnpm --filter webpage-guiexpert check:training",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": { "@guiexpert/table": ["../../packages/table/dist/index.d.ts"], "@guiexpert/table/css/*": ["../../packages/table/css/*"] }
  },
  "include": ["src/training/**/*.ts", "src/env.d.ts"],
  "exclude": ["src/training/examples/**"]
}
