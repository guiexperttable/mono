{
  "name": "guiexpert-mono",
  "version": "1.1.94",
  "private": true,
  "license": "MIT",
  "author": "Dr. Marc Kronberg <info@gui.expert> (https://gui.expert)",
  "description": "GuiExpert Table – mono repository: core, all framework wrappers (incl. Angular 14–22), demos and website",
  "repository": "https://github.com/guiexperttable/mono",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "i": "pnpm i",
    "build:core": "pnpm --filter @guiexpert/table build",
    "test:core": "pnpm --filter @guiexpert/table test",
    "test:core:unit": "pnpm --filter @guiexpert/table test:unit",
    "test:wrappers": "pnpm --filter \"./packages/*-table\" --workspace-concurrency=1 test",
    "build:libs": "pnpm --filter \"./packages/*\" build",
    "build:angular": "pnpm --filter \"./angular-builds/*\" build",
    "build:angular:ng14": "pnpm --filter angular-build-ng14 build",
    "build:angular:ng15": "pnpm --filter angular-build-ng15 build",
    "build:angular:ng16": "pnpm --filter angular-build-ng16 build",
    "build:angular:ng17": "pnpm --filter angular-build-ng17 build",
    "build:angular:ng18": "pnpm --filter angular-build-ng18 build",
    "build:angular:ng19": "pnpm --filter angular-build-ng19 build",
    "build:angular:ng20": "pnpm --filter angular-build-ng20 build",
    "build:angular:ng21": "pnpm --filter angular-build-ng21 build",
    "build:angular:ng22": "pnpm --filter angular-build-ng22 build",
    "sync:angular": "node scripts/sync-angular-src.mjs all",
    "build:all": "pnpm -r build",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "build:preact-table-demo": "pnpm --filter preact-table-demo build",
    "serve:preact-table-demo": "pnpm --filter preact-table-demo dev",
    "build:react-table-demo": "pnpm --filter react-table-demo build",
    "serve:react-table-demo": "pnpm --filter react-table-demo dev",
    "build:solid-table-demo": "pnpm --filter solid-table-demo build",
    "serve:solid-table-demo": "pnpm --filter solid-table-demo dev",
    "build:svelte-table-demo": "pnpm --filter svelte-table-demo build",
    "serve:svelte-table-demo": "pnpm --filter svelte-table-demo dev",
    "build:table-demo": "pnpm --filter table-demo build",
    "serve:table-demo": "pnpm --filter table-demo dev",
    "build:ts-todo-demo": "pnpm --filter ts-todo-demo build",
    "serve:ts-todo-demo": "pnpm --filter ts-todo-demo dev",
    "build:vue3-table-demo": "pnpm --filter vue3-table-demo build",
    "serve:vue3-table-demo": "pnpm --filter vue3-table-demo dev",
    "build:vue3-multi-demo": "pnpm --filter vue3-multi-demo build",
    "serve:vue3-multi-demo": "pnpm --filter vue3-multi-demo dev",
    "build:webcomponent-table-demo": "pnpm --filter webcomponent-table-demo build",
    "serve:webcomponent-table-demo": "pnpm --filter webcomponent-table-demo dev",
    "build:webpage-guiexpert": "pnpm --filter webpage-guiexpert build",
    "serve:webpage-guiexpert": "pnpm --filter webpage-guiexpert dev",
    "build:table": "pnpm --filter table build",
    "build:demo-table-models": "pnpm --filter demo-table-models build",
    "build:react-table": "pnpm --filter react-table build",
    "build:preact-table": "pnpm --filter preact-table build",
    "build:solid-table": "pnpm --filter solid-table build",
    "build:svelte-table": "pnpm --filter svelte-table build",
    "build:vue3-table": "pnpm --filter vue3-table build",
    "build:webcomponent-table": "pnpm --filter webcomponent-table build",
    "serve:angular-table-demo": "pnpm --filter angular-table-demo start",
    "pub:table": "pnpm --filter table npm-pub",
    "pub:demo-table-models": "pnpm --filter demo-table-models npm-pub",
    "pub:react-table": "pnpm --filter react-table npm-pub",
    "pub:preact-table": "pnpm --filter preact-table npm-pub",
    "pub:solid-table": "pnpm --filter solid-table npm-pub",
    "pub:svelte-table": "pnpm --filter svelte-table npm-pub",
    "pub:vue3-table": "pnpm --filter vue3-table npm-pub",
    "pub:webcomponent-table": "pnpm --filter webcomponent-table npm-pub",
    "pub:angular": "pnpm --filter \"./angular-builds/*\" npm-pub",
    "pub:all:dry": "node scripts/publish.mjs --dry-run",
    "pub:all": "node scripts/publish.mjs"
  },
  "pnpm": {
    "overrides": {
      "@jridgewell/sourcemap-codec": "^1.6.0"
    },
    "packageExtensions": {
      "@angular/animations": {
        "peerDependencies": {
          "@angular/common": "*"
        }
      }
    }
  }
}
