{
  "name": "@guiexpert/svelte-table",
  "version": "5.1.104",
  "license": "MIT",
  "author": "Dr. Marc Kronberg <info@gui.expert> (https://gui.expert)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guiexperttable/mono.git",
    "directory": "packages/svelte-table"
  },
  "homepage": "https://gui.expert",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "svelte": "./index.js",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "scripts": {
    "i": "pnpm i",
    "patch-version": "node patch.js",
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "npm-pub": "pnpm publish --no-git-checks --access public"
  },
  "publishConfig": {
    "directory": "dist",
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./index.js",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@guiexpert/table": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.38.0",
    "svelte-check": "^2.10.2",
    "svelte-jester": "^2.3.2",
    "svelte-preprocess": "^5.0.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^4.0.5",
    "@tsconfig/svelte": "^4.0.1",
    "eslint-plugin-svelte3": "^4.0.0",
    "@types/react": "^18.2.37 || ^19.0.0",
    "@types/react-dom": "^18.2.15 || ^19.0.0",
    "@types/node": "^20.11.17",
    "vite": "6.4.4",
    "vite-plugin-dts": "^3.7.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-static-copy": "^0.17.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vite-plugin-babel": "^1.2.0",
    "@vitejs/plugin-react": "^4.1.1",
    "ts-node": "10.9.1",
    "tsconfig": "^7.0.0",
    "typescript": "5.2.2",
    "@babel/core": "~7.28.6",
    "vitest": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "playwright": "1.64.0",
    "svelte4": "npm:svelte@^4.2.20"
  },
  "description": "Svelte 4 and 5 wrapper of the GuiExpert Table (@guiexpert/table)."
}
