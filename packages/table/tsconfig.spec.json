{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@guiexpert/table": ["./src/index.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "test-utils/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
